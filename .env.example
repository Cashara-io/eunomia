# copy to .env and fill in before `docker compose up`

# Signs browser-session JWTs. Leave blank for local dev (a random secret is
# generated at process startup, but sessions won't survive a restart) --
# set it explicitly for anything long-running or multi-process.
JWT_SECRET=

# AES-256-GCM key for connector credential and API key encryption. Required (at
# least 16 characters): a new install refuses to boot without one. It also protects the per-org database passwords,
# so keep a copy off this machine. Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=
# Only for an install that used to run with an empty ENCRYPTION_KEY: lets values
# written under it still decrypt. "Update now" sets it when it adds a key; see
# docs/deployment.md, "Rotating ENCRYPTION_KEY".
# ENCRYPTION_KEY_LEGACY_EMPTY=1

SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=eunomia
SURREAL_DB=eunomia

# Optional. A connected AI agent (MCP) can recall and write memory with its own
# model; an OpenAI-compatible endpoint is recommended to save its tokens (Eunomia
# then does embeddings and answer synthesis itself, and powers the in-app chat).
# 1. Endpoint. The default for every user (each can point Settings at their
# own) -- point this at a self-hosted/alternate provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Key (blank is fine for a self-hosted endpoint that needs none). Only ever
# sent to OPENAI_BASE_URL: a user who picks another base URL in Settings uses
# their own key there, never this one.
OPENAI_API_KEY=

# 3. Chat model for entity/relation extraction, answers and chat (blank =
# automatic: gpt-4o-mini on api.openai.com, otherwise the first chat model the
# endpoint lists at /models). Each user can override it in Settings.
OPENAI_CHAT_MODEL=

# Only selectable here, never from the DB -- "stub" is for hermetic tests only.
EMBEDDINGS_BACKEND=openai

# Browser origin allowed to make credentialed (cookie-session) requests to the
# backend API. Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:3000

FRONTEND_URL=http://localhost:3000

# Address MCP clients reach Eunomia at, no trailing slash. Used in OAuth discovery
# documents and as the audience of OAuth tokens. Use your domain behind a proxy.
PUBLIC_URL=http://localhost:8001

# Proxies whose X-Forwarded-For header the backend believes when rate limiting
# by client address. Comma-separated CIDRs, addresses or hostnames; blank means the compose frontend's
# service name (`frontend`) under docker compose, loopback only otherwise.
# Add your own reverse proxy's address if you put one in front of the backend;
# `none` trusts nobody.
TRUSTED_PROXIES=

# eunomia.* logger level: DEBUG/INFO/WARNING/ERROR/CRITICAL.
LOG_LEVEL=INFO

# Host ports docker-compose publishes the containers on (container-internal
# ports stay 8001/3000 either way).
BACKEND_PORT=8001
FRONTEND_PORT=3000

# Release whose prebuilt images run (set by the installer, bumped by
# scripts/auto-update.sh when you click "Update now" in Settings).
EUNOMIA_IMAGE_TAG=latest

# Encrypts nightly backups (the `backup` service refuses to start without it).
# Fresh installs: generate one before the first `docker compose up` with
#   openssl rand -base64 32
# and paste it here (the auto-updater adds one for you when updating an older install).
# Left empty, the backup service makes a key on first start and stores it in its own volume
# (beside the backups, so setting it here is safer). Store a copy somewhere outside this machine: without it backups cannot be read.
BACKUP_ENCRYPTION_KEY=

# Optional observability (see docs/observability.md). Leave unset to export nothing.
# With the SigNoz profile running: http://signoz-otel-collector:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=eunomia-backend

# HTTPS with a free Let's Encrypt certificate (the `caddy` service, see
# ./Caddyfile). Needs a domain whose DNS points at this machine and ports
# 80/443 reachable from the internet. Set by the installer's --domain /
# --acme-email flags or Settings, HTTPS (which also sets PUBLIC_URL,
# FRONTEND_TRUST_FORWARDED=1 and FRONTEND_BIND=127.0.0.1 so Caddy's
# X-Forwarded-* headers are believed and :3000 is no longer open to the network).
# By hand, uncomment these and set those three too, then run `docker compose up -d`.
# COMPOSE_PROFILES=https
# EUNOMIA_DOMAIN=eunomia.example.com
# EUNOMIA_ACME_EMAIL=you@example.com

# Single sign-on through an OpenID Connect provider (Okta, Entra ID, Google, Keycloak, AuthKit, ...).
# AUTH_MODE: password (default, email + password only) | both | oidc (provider only, passwords off).
# Redirect URI to register at the provider: ${PUBLIC_URL}/api/auth/oidc/callback. See docs/deployment.md.
# AUTH_MODE=both
# OIDC_ISSUER=https://dev-123456.okta.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=Okta
